# Camera
CAMERA_ID=cam_test
CAMERA_SOURCE=0            # 0 = webcam; rtsp://user:pass@192.168.1.50:554/stream1; hoặc data/test_videos/x.mp4
STREAM_FPS=15
STREAM_WIDTH=1280
JPEG_QUALITY=80

# Hạ tầng
REDIS_URL=redis://redis:6379/0          # chạy ngoài Docker: redis://localhost:6379/0
DATABASE_URL=sqlite:////app/data/smarthome.db   # chạy ngoài Docker: sqlite:///data/smarthome.db
DATA_DIR=/app/data                      # chạy ngoài Docker: data
TZ=Asia/Ho_Chi_Minh

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_ENABLED=true            # false nếu token đang được bot khác nhận tin (long polling)
TELEGRAM_ALLOWED_CHAT_IDS=              # danh sách chat_id cách nhau dấu phẩy; trống = chỉ TELEGRAM_CHAT_ID

# Trò chuyện
LLM_PROVIDER=gemini        # gemini | ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
ASSISTANT_URL=http://assistant_api:8000

# Mô hình AI
FACE_MODEL=buffalo_l
OBJECT_MODEL=yoloe-26s-seg.pt
POSE_MODEL=yolo26n-pose.pt
MODELS_DIR=/app/models

# Giọng nói
VOICE_ENABLED=false
WHISPER_MODEL=small
TTS_VOICE=vi-VN-HoaiMyNeural

# Trang web công khai (Vercel/Netlify) được phép gọi API máy nhà, vd. https://smart-home-ai.vercel.app
CORS_ORIGINS=

# Dashboard
DASHBOARD_PASSWORD=
